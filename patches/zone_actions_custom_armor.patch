 local function motion_duration(name,uncached)
     local available, visual = model_motions()
-    -- Keep successful checks only for this validated action and this model.
-    -- A new action still checks the active native model before touching it.
     if not uncached and scene and scene.visual==visual and scene.motion_lengths then
         local duration=scene.motion_lengths[name]
         if duration then return duration end
     end
-    if not available or not available[name] then
-        return nil, visual .. ": " .. name
-    end
-    if game.motion_exists then
-        local model = visual .. ".ogf"
-        if not getFS():exist("$game_meshes$", model) or not game.motion_exists(model, name) then
-            return nil, visual .. ": " .. name
-        end
-    end
-    return motion_files.get(visual)[name] or available[name]
+
+    -- Native checks take precedence over a stale catalogue entry. The old
+    -- implementation rejected any unknown custom armor visual *before* this
+    -- test was reached, even if the animation existed in its loaded OMF.
+    local native=native_motion_available(visual,name)
+    if native==false then return nil,visual..": "..name end
+
+    -- When available, use timing parsed from the actually selected OGF/OMF.
+    -- Parsing is cached once per visual, including negative results.
+    local parsed=motion_files.get(visual)[name]
+    if type(parsed)=="number" and parsed>0 and parsed<600 then
+        return parsed
+    end
+
+    if native==true then
+        -- Packed OMFs are often not readable by io.open, even when the engine
+        -- can play the motion. Nominal base durations affect only scheduling;
+        -- they must never be used as proof that an animation exists.
+        local duration=(available and available[name]) or load_data().durations[name]
+        if type(duration)=="number" and duration>0 then return duration end
+    elseif available and available[name] then
+        -- Engines without game.motion_exists retain the legacy catalogue
+        -- behavior. An unknown model requires independently parsed motion
+        -- metadata (handled above), otherwise it remains safely blocked.
+        return available[name]
+    end
+    return nil,visual..": "..name
 end
 
