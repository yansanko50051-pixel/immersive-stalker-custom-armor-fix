+-- nil = native probe unavailable; true/false = verified engine result.
+-- This function is never called from the per-frame update path: only when a
+-- player starts an action (or from the existing idle restore check).
+local function native_motion_available(visual,name)
+    if not game or type(game.motion_exists) ~= "function" then return nil end
+    if motion_probe.visual ~= visual then
+        motion_probe.visual=visual
+        motion_probe.checked={}
+    end
+    local previous=motion_probe.checked[name]
+    if previous ~= nil then return previous end
+    local model=visual..".ogf"
+    if not getFS():exist("$game_meshes$",model) then
+        motion_probe.checked[name]=false
+        return false
+    end
+    local ok,exists=pcall(game.motion_exists,model,name)
+    if not ok then
+        -- An exception from a native query must not become permission to play
+        -- an unknown motion. Treat as unsupported rather than risking a crash.
+        log("Motion probe error: "..visual.." / "..name..": "..tostring(exists))
+        motion_probe.checked[name]=false
+        return false
+    end
+    local result=not not exists
+    motion_probe.checked[name]=result
+    return result
+end
